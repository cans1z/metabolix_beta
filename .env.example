# для локального запуска заданы значения по умолчанию
# на сервере скопируй файл в .env и задай свои значения

# production отключает документацию api и не даст запуститься с ключом по умолчанию
ASPNETCORE_ENVIRONMENT=Production

# случайный ключ длиной от 32 символов
JWT_KEY=

POSTGRES_PASSWORD=

# идентификатор приложения из консоли гугла
GOOGLE_CLIENT_ID=
