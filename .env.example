# Для локального запуска этот файл не нужен: у всех настроек есть значения по умолчанию.
# На настоящем сервере скопируйте его в .env и задайте свои значения.

# Production отключает документацию API и не даст запуститься с ключом по умолчанию.
ASPNETCORE_ENVIRONMENT=Production

# Случайная строка не короче 32 символов.
JWT_KEY=

POSTGRES_PASSWORD=

# Client ID из Google Cloud Console. Пока пусто, вход через Google отвечает 503.
GOOGLE_CLIENT_ID=
